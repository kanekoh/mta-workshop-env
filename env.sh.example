#!/bin/bash

###############################################################################
# 環境変数設定ファイル（認証情報・シークレットのみ）
#
# 使用方法：
# 1. このファイルを env.sh にコピー
#    cp env.sh.example env.sh
#
# 2. 各変数を実際の値に置き換える
#
# 注意:
#   - クラスター構成（マシンタイプ、ノード数等）は profiles/*.env で管理します
#   - このファイルにはシークレットとAWSアカウント共通設定のみを記載します
###############################################################################

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AWS認証情報
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
export AWS_DEFAULT_REGION="ap-northeast-1"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Red Hat Cloud Services 認証
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ROSA CLI にログインするには以下のいずれかを実行してください：
#   ブラウザ環境:   rosa login --use-auth-code
#   ブラウザレス環境: rosa login --use-device-code
#
# Terraform (RHCS provider) 向けの認証方法:
# サービスアカウント（推奨）
# https://console.redhat.com/iam/service-accounts/
export RHCS_CLIENT_ID="YOUR_RHCS_CLIENT_ID"
export RHCS_CLIENT_SECRET="YOUR_RHCS_CLIENT_SECRET"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# クラスター名プレフィックス（任意）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# プロファイルで定義されるベース名の前に付与されます
# 例: CLUSTER_NAME_PREFIX="hkaneko" + profile の "mta-light" → "hkaneko-mta-light"
# 未設定の場合: ベース名がそのまま使用されます（Warning 表示）
# export CLUSTER_NAME_PREFIX="your-prefix"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Terraform 共通設定（インフラ・課金）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Provider プラグインキャッシュ（network/cluster 間で共有し重複DLを防ぐ）
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.terraform-plugin-cache}"
mkdir -p "${TF_PLUGIN_CACHE_DIR}"

export TF_VAR_aws_region="ap-northeast-1"
export TF_VAR_vpc_cidr="10.0.0.0/16"
export TF_VAR_billing_account="YOUR_BILLING_ACCOUNT_ID"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 共通デフォルト（profile で上書き可能）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OCP バージョン（全プロファイル共通のデフォルト。profile 側で個別に上書き可能）
export TF_VAR_ocp_version="4.20.2"

# ワークショップユーザー数（profile で上書きしない場合のデフォルト）
export TF_VAR_admin_count="1"
export TF_VAR_workshop_user_count="20"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# パスワード（任意・シークレット）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HTPasswd IDP 用パスワード
# export TF_VAR_admin_password="YOUR_ADMIN_PASSWORD"
# export TF_VAR_workshop_user_password="YOUR_WORKSHOP_USER_PASSWORD"

# Cluster Admin User（未設定時は Terraform がランダム生成）
# export TF_VAR_cluster_admin_username="cluster-admin"
# export TF_VAR_cluster_admin_password="your-fixed-password"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AWS IAM ユーザー（任意）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RHACM/DevSpaces Operator の ROLEARN に使用
# 未指定時: AWS_ACCESS_KEY_ID から自動取得
# export TF_VAR_admin_user_name="your-iam-user-name"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 外部サービス連携（任意・シークレット）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Tackle KAI 連携用 OpenAI 互換 API
# export OPENAI_API_BASE=""
# export OPENAI_API_KEY=""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "環境変数を読み込みました (env.sh)"
echo "  AWS Region: ${AWS_DEFAULT_REGION}"
echo "  Prefix: ${CLUSTER_NAME_PREFIX:-（未設定）}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
