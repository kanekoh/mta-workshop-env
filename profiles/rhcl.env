#!/bin/bash
# Profile: rhcl
# Red Hat Connectivity Link (RHCL) 検証環境
# RHCL 1.3 + cert-manager + Gateway API (OCP Ingress Operator)
# OCP 4.19+ が必要（Gateway API CRD が同梱されるため）

export PROFILE_NAME="rhcl"
export GITOPS_ENV="rhcl"

# --- クラスター識別 ---
export TF_VAR_cluster_name="rhcl"
export TF_VAR_ocp_version="4.21.23"

# --- クラスター構成 ---
export CLUSTER_VIA="terraform"
export TF_VAR_rosa_machine_type="m6a.2xlarge"
export TF_VAR_worker_pool_replicas="2"
export TF_VAR_availability_zone_count="1"

# --- GPU ノードプール（なし）---
export GPU_MACHINE_TYPE=""
export GPU_REPLICAS="0"

# --- Ansible 制御 ---
export RUN_ANSIBLE="true"
export ANSIBLE_PLAYBOOKS="gitops,configmaps"

# --- ワークショップユーザー ---
export TF_VAR_admin_count="1"
export TF_VAR_workshop_user_count="1"
