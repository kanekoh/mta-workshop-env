#!/bin/bash
# Profile: ai-serving
# OpenShift AI モデルサービング + LiteLLM 環境
# RHOAI 3.4 (fast-3.x) + NVIDIA GPU + NFD + cert-manager + LiteLLM

export PROFILE_NAME="ai-serving"
export GITOPS_ENV="ai-serving"

# --- クラスター識別 ---
export TF_VAR_cluster_name="ai-serving"
export TF_VAR_ocp_version="4.22.5"

# --- クラスター構成 ---
export CLUSTER_VIA="terraform"
export TF_VAR_rosa_machine_type="m6a.2xlarge"
export TF_VAR_worker_pool_replicas="2"
export TF_VAR_availability_zone_count="1"

# --- GPU ノードプール ---
export GPU_MACHINE_TYPE="g6.xlarge"
export GPU_REPLICAS="1"

# --- Ansible 制御 ---
export RUN_ANSIBLE="true"
export ANSIBLE_PLAYBOOKS="gitops,configmaps,odh_storage"

# --- ワークショップユーザー ---
export TF_VAR_admin_count="1"
export TF_VAR_workshop_user_count="5"
