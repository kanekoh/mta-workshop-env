#!/bin/bash
# Profile: bare
# 素の ROSA HCP 環境（Operator なし）
# GitOps (ArgoCD) のみインストール。apps/ は空のため何もデプロイされない。
# 後から Operator を追加したい場合は gitops/environments/bare/apps/ に
# Application YAML を配置すれば ArgoCD が自動検出する。

export PROFILE_NAME="bare"
export GITOPS_ENV="bare"

# --- クラスター識別 ---
export TF_VAR_cluster_name="bare"
export TF_VAR_ocp_version="4.22.5"

# --- クラスター構成 ---
export CLUSTER_VIA="terraform"
export TF_VAR_rosa_machine_type="m6a.xlarge"
export TF_VAR_worker_pool_replicas="2"
export TF_VAR_availability_zone_count="1"

# --- GPU ノードプール ---
export GPU_MACHINE_TYPE=""
export GPU_REPLICAS="0"

# --- Ansible 制御 ---
export RUN_ANSIBLE="true"
export ANSIBLE_PLAYBOOKS="gitops"

# --- ユーザー ---
export TF_VAR_admin_count="1"
export TF_VAR_workshop_user_count="0"
