#!/bin/bash
# Profile: platform-ops
# プラットフォーム運用系 Operator をまとめた環境
# RHACS, GitOps (already installed), ServiceMesh 3, OADP, Pipelines, Logging
# GPU 不要。Operator のリソース消費確認用。

export PROFILE_NAME="platform-ops"
export GITOPS_ENV="platform-ops"

# --- クラスター識別 ---
export TF_VAR_cluster_name="platform-ops"
export TF_VAR_ocp_version="4.22.5"

# --- クラスター構成 ---
export CLUSTER_VIA="terraform"
export TF_VAR_rosa_machine_type="m6a.2xlarge"
export TF_VAR_worker_pool_replicas="0"
export TF_VAR_availability_zone_count="1"

# --- GPU ノードプール ---
export GPU_MACHINE_TYPE=""
export GPU_REPLICAS="0"

# --- Ansible 制御 ---
export RUN_ANSIBLE="true"
export ANSIBLE_PLAYBOOKS="gitops"

# --- ユーザー ---
export TF_VAR_admin_count="1"
export TF_VAR_workshop_user_count="0"
